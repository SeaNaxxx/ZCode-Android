@@ -83,6 +83,10 @@ export function createProjectService(options: {
 }): IProjectService {
   const route = async (hostId?: string) => {
     if (!hostId || hostId === (options.ownerHostId ?? "local")) return null;
+    // 独立 Server 是 Web 客户端眼中唯一的 Host：前端对未携带 workspaceIdentity 的
+    // 既有会话以 local 发起（SessionPane 发送前解析目录、任务分组按 Host 读树），
+    // 此 local 即服务端本机，不得按离线远端拒绝。
+    if (hostId === "local" && options.ownerHostId && options.ownerHostId !== "local") return null;
     if (!options.resolveHost) throw new Error("project.host-offline");
     return options.resolveHost(hostId);
   };
