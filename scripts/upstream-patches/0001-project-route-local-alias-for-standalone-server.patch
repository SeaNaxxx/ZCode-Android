+it("standalone server treats local as its own host for UI calls without workspace identity", async () => {
+  // 独立 Server 的 ownerHostId 是远端风格的 Source Server 身份（remote:server:<id>），
+  // 但它就是客户端眼中唯一的本机：SessionPane 对既有会话的发送前
+  // resolveSessionDirectories(task, "local")、任务分组按 Host readTree({hostId:"local"})
+  // 都必须落到本仓库，而不是按离线远端拒绝（真机观察到的第二条消息发送失败）。
+  const readTree = vi.fn(async () => ({ projects: [], tasks: [] }));
+  const resolveSessionDirectories = vi.fn(async () => ({
+    projectId: "p",
+    workspacePath: "/ws",
+    additionalDirectories: [],
+  }));
+  const repository = vi.fn(async () =>
+    ({ readTree, resolveSessionDirectories }) as unknown as ProjectRepositoryContract,
+  );
+  const service = createProjectService({
+    repository,
+    workspaceDirectory: "/workspace",
+    ownerHostId: "remote:server:localhost",
+  });
+  expect(await service.readTree({ hostId: "local" })).toEqual({ projects: [], tasks: [] });
+  expect(
+    await service.resolveSessionDirectories({ workspacePath: "/ws", taskId: "s" }, "local"),
+  ).toEqual({ projectId: "p", workspacePath: "/ws", additionalDirectories: [] });
+  expect(readTree).toHaveBeenCalledTimes(1);
+  expect(resolveSessionDirectories).toHaveBeenCalledTimes(1);
+  // 其余远端身份仍然拒绝：没有 resolveHost 时不得假装存在连接。
+  await expect(service.readTree({ hostId: "remote:server:other" })).rejects.toThrow(
+    "project.host-offline",
+  );
+});
+
